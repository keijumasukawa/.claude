{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/check-readme-isolation.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "README の分離を検査中"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(gh pr merge:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(npx:*)",
      "Bash(git commit:*)",
      "Bash(git -C * commit:*)",
      "Bash(git merge:*)",
      "Bash(git -C * merge:*)",
      "Bash(git rebase:*)",
      "Bash(git -C * rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git -C * reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(git -C * filter-branch:*)",
      "Bash(rm:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git tag)",
      "Bash(git stash list)",
      "Bash(git reflog)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git -C * status:*)",
      "Bash(git -C * diff:*)",
      "Bash(git -C * log:*)",
      "Bash(git -C * show:*)",
      "Bash(git -C * blame:*)",
      "Bash(git -C * ls-files:*)",
      "Bash(git -C * ls-remote:*)",
      "Bash(git -C * rev-parse:*)",
      "Bash(git -C * branch -v)",
      "Bash(git -C * branch -vv)",
      "Bash(git -C * branch --show-current)",
      "Bash(git -C * remote -v)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh label list:*)",
      "Bash(gh auth status)",
      "Bash(gh search:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test)",
      "Bash(pnpm list:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm audit)"
    ]
  }
}
